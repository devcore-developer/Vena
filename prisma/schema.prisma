// VENA — Medical Education Platform
// Prisma Schema for PostgreSQL
// Compatible with @prisma/client ^5.14.0

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  SUPER_ADMIN
  DOCTOR
  SECRETARY
  STUDENT
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

enum Permission {
  VIEW_STUDENTS
  MANAGE_STUDENTS
  VIEW_COURSES
  MANAGE_COURSES
  VIEW_EXAMS
  MANAGE_EXAMS
  VIEW_SUBMISSIONS
  MANAGE_SUBMISSIONS
  VIEW_MESSAGES
  MANAGE_MESSAGES
  VIEW_SUPPORT
  MANAGE_SUPPORT
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum LessonType {
  VIDEO
  PDF
  TEXT
  FILE
}

enum ExamType {
  COURSE_EXAM
  PRACTICE_EXAM
  PREVIOUS_EXAM
}

enum ExamStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  ESSAY
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  GRADED
  EXPIRED
}

enum EnrollmentStatus {
  PENDING
  ACTIVE
  COMPLETED
  SUSPENDED
  CANCELLED
}

enum PaymentMethod {
  CASH
  INSTAPAY
  VODAFONE_CASH
}

enum CommissionType {
  FIXED
  PERCENTAGE
}

enum FinancialTxType {
  COURSE_SALE
  REFUND
  ADJUSTMENT
  PAYOUT
}

enum FinancialTxStatus {
  PENDING
  POSTED
  REVERSED
}

enum PaymentStatus {
  AWAITING_PAYMENT
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  CANCELLED
}

enum PayoutStatus {
  REQUESTED
  APPROVED
  PROCESSING
  COMPLETED
  REJECTED
  CANCELLED
}

enum FreeResourceType {
  PDF
  VIDEO
  TEXT
  FILE
  IMAGE
  LINK
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum NotificationType {
  PAYMENT_APPROVED
  SUPPORT_REPLY
  DOCTOR_MESSAGE
  SYSTEM
}

enum SupportStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_USER
  RESOLVED
  CLOSED
}

enum SupportPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ConversationStatus {
  OPEN
  CLOSED
}

enum AnnouncementType {
  INFO
  WARNING
  IMPORTANT
  MAINTENANCE
}

enum SettingType {
  STRING
  NUMBER
  BOOLEAN
  JSON
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

// ============================================================
// IDENTITY AND ACCESS
// ============================================================

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  role         Role       @default(STUDENT)
  status       UserStatus @default(ACTIVE)
  phone        String?
  avatarUrl    String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  doctorProfile       DoctorProfile?
  secretaryProfile    SecretaryProfile?
  secretaries         SecretaryProfile[]    @relation("DoctorSecretary")
  coursesOwned        Course[]
  enrollments         Enrollment[]
  examsCreated        Exam[]
  examAttempts        ExamAttempt[]
  lessonProgress      LessonProgress[]
  paymentsMade        Payment[]             @relation("StudentPayments")
  paymentsReviewed    Payment[]             @relation("PaymentReviewer")
  payoutsReceived     DoctorPayout[]        @relation("DoctorPayouts")
  payoutsApproved     DoctorPayout[]        @relation("PayoutApprover")
  finTxAsDoctor       FinancialTransaction[] @relation("FinTxDoctor")
  finTxAsStudent      FinancialTransaction[] @relation("FinTxStudent")
  supportTicketsOwned SupportTicket[]       @relation("TicketOwner")
  supportAssigned     SupportTicket[]       @relation("TicketAssignee")
  supportMessages     SupportMessage[]
  conversationsAsDoc  DoctorConversation[]  @relation("DocConversations")
  conversationsAsStu  DoctorConversation[]  @relation("StuConversations")
  doctorMessagesSent  DoctorMessage[]
  notifications       Notification[]
  notificationPref     NotificationPreference?
  savedFreeResources  SavedFreeResource[]
  auditLogs           AuditLog[]
  passwordResetTokens PasswordResetToken[]
  secretaryInvitesSent SecretaryInvitation[] @relation("InvitationSender")

  @@index([role])
  @@index([status])
  @@index([email])
}

model DoctorProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug        String   @unique
  specialty   String
  bio         String?  @db.Text
  rating      Decimal  @default(0) @db.Decimal(3, 1)
  isVerified  Boolean  @default(false)
  isAvailable Boolean  @default(true)
  avatarColor String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
  @@index([isVerified])
}

model SecretaryProfile {
  id          String       @id @default(cuid())
  userId      String       @unique
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  doctorId    String
  doctor      User         @relation("DoctorSecretary", fields: [doctorId], references: [id])
  permissions Permission[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([doctorId])
}

model SecretaryInvitation {
  id          String           @id @default(cuid())
  email       String
  doctorId    String
  doctor      User             @relation("InvitationSender", fields: [doctorId], references: [id])
  token       String           @unique
  permissions Permission[]
  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime
  createdAt   DateTime         @default(now())

  @@index([doctorId])
  @@index([email])
  @@index([token])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([token])
}

// ============================================================
// EDUCATIONAL CONTENT
// ============================================================

model CourseCategory {
  id             String         @id @default(cuid())
  name           String
  slug           String         @unique
  courses        Course[]
  freeResources  FreeResource[]
  previousExams  PreviousExam[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model Course {
  id                String        @id @default(cuid())
  doctorId          String
  doctor            User          @relation(fields: [doctorId], references: [id])
  title             String
  slug              String        @unique
  shortDescription  String?
  description       String?       @db.Text
  thumbnail         String?
  thumbnailColor    String?
  categoryId        String?
  category          CourseCategory? @relation(fields: [categoryId], references: [id])
  price             Decimal       @default(0) @db.Decimal(10, 2)
  status            CourseStatus  @default(DRAFT)
  level             String        @default("BEGINNER")
  language          String        @default("ENGLISH")
  estimatedDuration Int?
  rating            Decimal?      @db.Decimal(3, 1)
  publishedAt       DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  sections         CourseSection[]
  enrollments      Enrollment[]
  exams            Exam[]
  payments         Payment[]
  financialTx      FinancialTransaction[]
  conversations    DoctorConversation[]

  @@index([doctorId])
  @@index([categoryId])
  @@index([status])
  @@index([slug])
}

model CourseSection {
  id          String         @id @default(cuid())
  courseId    String
  course      Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String?        @db.Text
  order       Int            @default(0)
  lessons     CourseLesson[]

  @@index([courseId])
}

model CourseLesson {
  id          String           @id @default(cuid())
  sectionId   String
  section     CourseSection    @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  title       String
  description String?           @db.Text
  type        LessonType
  content     String?           @db.Text
  resourceUrl String?
  duration    Int?
  order       Int              @default(0)
  isPreview   Boolean          @default(false)
  isPublished Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  lessonProgress LessonProgress[]

  @@index([sectionId])
  @@index([isPublished])
}

model LessonProgress {
  id          String      @id @default(cuid())
  studentId   String
  student     User        @relation(fields: [studentId], references: [id])
  lessonId    String
  lesson      CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completed   Boolean     @default(false)
  completedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([studentId, lessonId])
  @@index([studentId])
  @@index([lessonId])
}

model Enrollment {
  id          String           @id @default(cuid())
  studentId   String
  student     User             @relation(fields: [studentId], references: [id])
  courseId    String
  course      Course           @relation(fields: [courseId], references: [id])
  status      EnrollmentStatus @default(PENDING)
  enrolledAt  DateTime         @default(now())
  activatedAt DateTime?
  completedAt DateTime?
  progress    Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  payments    Payment[]

  @@unique([studentId, courseId])
  @@index([studentId])
  @@index([courseId])
  @@index([status])
}

// ============================================================
// EXAMS
// ============================================================

model Exam {
  id              String      @id @default(cuid())
  doctorId        String
  doctor          User        @relation(fields: [doctorId], references: [id])
  courseId        String?
  course          Course?     @relation(fields: [courseId], references: [id])
  title           String
  description     String?     @db.Text
  type            ExamType
  duration        Int
  passingScore    Int
  attemptsAllowed Int         @default(1)
  status          ExamStatus  @default(DRAFT)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  questions  Question[]
  attempts   ExamAttempt[]

  @@index([doctorId])
  @@index([courseId])
  @@index([status])
}

model Question {
  id          String       @id @default(cuid())
  examId      String
  exam        Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  text        String       @db.Text
  type        QuestionType
  points      Int          @default(1)
  order       Int          @default(0)
  explanation String?      @db.Text
  choices     QuestionChoice[]
  answers     ExamAnswer[]

  @@index([examId])
}

model QuestionChoice {
  id         String       @id @default(cuid())
  questionId String
  question   Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  isCorrect  Boolean      @default(false)
  order      Int          @default(0)
  answers    ExamAnswer[]

  @@index([questionId])
}

model ExamAttempt {
  id          String        @id @default(cuid())
  examId      String
  exam        Exam          @relation(fields: [examId], references: [id])
  studentId   String
  student     User          @relation(fields: [studentId], references: [id])
  startedAt   DateTime      @default(now())
  submittedAt DateTime?
  score       Int?
  percentage  Decimal?      @db.Decimal(5, 2)
  passed      Boolean?
  status      AttemptStatus @default(IN_PROGRESS)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  answers     ExamAnswer[]

  @@index([examId])
  @@index([studentId])
  @@index([status])
}

model ExamAnswer {
  id         String          @id @default(cuid())
  attemptId  String
  attempt    ExamAttempt     @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId String
  question   Question        @relation(fields: [questionId], references: [id])
  choiceId   String?
  choice     QuestionChoice? @relation(fields: [choiceId], references: [id])
  textAnswer String?         @db.Text
  createdAt  DateTime        @default(now())

  @@unique([attemptId, questionId])
  @@index([attemptId])
}

// ============================================================
// PAYMENTS AND FINANCE
// ============================================================

model Payment {
  id              String        @id @default(cuid())
  studentId       String
  student         User          @relation("StudentPayments", fields: [studentId], references: [id])
  courseId        String
  course          Course        @relation(fields: [courseId], references: [id])
  enrollmentId    String?
  enrollment      Enrollment?   @relation(fields: [enrollmentId], references: [id])
  amount          Decimal       @db.Decimal(10, 2)
  currency        String        @default("EGP")
  method          PaymentMethod
  status          PaymentStatus @default(PENDING)
  referenceNumber String?
  proofUrl        String?
  studentNote     String?       @db.Text
  rejectionReason String?       @db.Text
  adminNote       String?       @db.Text
  reviewedBy      String?
  reviewer        User?         @relation("PaymentReviewer", fields: [reviewedBy], references: [id])
  reviewedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  paymentConfigSnapshot Json?
  financialTransactions FinancialTransaction[]

  @@index([studentId])
  @@index([courseId])
  @@index([status])
  @@index([enrollmentId])
}

model PlatformFeeConfig {
  id          String         @id @default(cuid())
  type        CommissionType
  fixedAmount Decimal?       @db.Decimal(10, 2)
  percentage  Decimal?       @db.Decimal(5, 2)
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model FinancialTransaction {
  id                 String            @id @default(cuid())
  paymentId          String?
  payment            Payment?          @relation(fields: [paymentId], references: [id])
  payoutId           String?
  payout             DoctorPayout?     @relation("PayoutFinTx", fields: [payoutId], references: [id])
  courseId           String?
  course             Course?           @relation(fields: [courseId], references: [id])
  doctorId           String
  doctor             User              @relation("FinTxDoctor", fields: [doctorId], references: [id])
  studentId          String?
  student            User?             @relation("FinTxStudent", fields: [studentId], references: [id])
  grossAmount        Decimal           @db.Decimal(10, 2)
  platformCommission Decimal           @db.Decimal(10, 2)
  doctorNet          Decimal           @db.Decimal(10, 2)
  currency           String            @default("EGP")
  type               FinancialTxType
  status             FinancialTxStatus @default(PENDING)
  createdAt          DateTime          @default(now())

  @@index([paymentId])
  @@index([payoutId])
  @@index([doctorId])
  @@index([studentId])
  @@index([courseId])
  @@index([status])
  @@index([type])
}

model DoctorPayout {
  id          String       @id @default(cuid())
  doctorId    String
  doctor      User         @relation("DoctorPayouts", fields: [doctorId], references: [id])
  amount      Decimal      @db.Decimal(10, 2)
  currency    String       @default("EGP")
  method      String
  status      PayoutStatus @default(REQUESTED)
  reference   String?
  note        String?      @db.Text
  approvedBy  String?
  approver    User?        @relation("PayoutApprover", fields: [approvedBy], references: [id])
  processedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  financialTransactions FinancialTransaction[] @relation("PayoutFinTx")

  @@index([doctorId])
  @@index([status])
}
// ============================================================
// SUPPORT AND COMMUNICATION
// ============================================================

model SupportTicket {
  id          String          @id @default(cuid())
  userId      String
  user        User            @relation("TicketOwner", fields: [userId], references: [id])
  subject     String
  category    String
  priority    SupportPriority @default(MEDIUM)
  status      SupportStatus   @default(OPEN)
  assignedTo  String?
  assignee    User?           @relation("TicketAssignee", fields: [assignedTo], references: [id])
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  messages    SupportMessage[]

  @@index([userId])
  @@index([status])
  @@index([priority])
  @@index([assignedTo])
}

model SupportMessage {
  id        String        @id @default(cuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User          @relation(fields: [senderId], references: [id])
  body      String        @db.Text
  createdAt DateTime      @default(now())

  @@index([ticketId])
  @@index([senderId])
}

model DoctorConversation {
  id         String             @id @default(cuid())
  doctorId   String
  doctor     User               @relation("DocConversations", fields: [doctorId], references: [id])
  studentId  String
  student    User               @relation("StuConversations", fields: [studentId], references: [id])
  courseId   String?
  course     Course?            @relation(fields: [courseId], references: [id])
  status     ConversationStatus @default(OPEN)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  messages   DoctorMessage[]

  @@unique([doctorId, studentId, courseId])
  @@index([doctorId])
  @@index([studentId])
  @@index([status])
}

model DoctorMessage {
  id              String             @id @default(cuid())
  conversationId  String
  conversation    DoctorConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId        String
  sender          User               @relation(fields: [senderId], references: [id])
  body            String             @db.Text
  isRead          Boolean            @default(false)
  readAt          DateTime?
  createdAt       DateTime           @default(now())

  @@index([conversationId])
  @@index([senderId])
  @@index([isRead])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String            @db.Text
  href      String?
  isRead    Boolean           @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([isRead])
}

model NotificationPreference {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailEnabled    Boolean  @default(true)
  pushEnabled     Boolean  @default(true)
  paymentAlerts   Boolean  @default(true)
  supportReplies  Boolean  @default(true)
  doctorMessages  Boolean  @default(true)
  systemAlerts    Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ============================================================
// FREE VENA
// ============================================================

model FreeResource {
  id          String           @id @default(cuid())
  title       String
  slug        String           @unique
  description String?          @db.Text
  type        FreeResourceType
  categoryId  String?
  category    CourseCategory?  @relation(fields: [categoryId], references: [id])
  thumbnail   String?
  content     String?          @db.Text
  resourceUrl String?
  videoUrl    String?
  status      ContentStatus    @default(DRAFT)
  isFeatured  Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  savedBy     SavedFreeResource[]

  @@index([categoryId])
  @@index([status])
  @@index([type])
  @@index([isFeatured])
}

model PreviousExam {
  id          String          @id @default(cuid())
  title       String
  slug        String          @unique
  description String?         @db.Text
  year        Int
  university  String?
  faculty     String?
  specialty   String?
  categoryId  String?
  category    CourseCategory?  @relation(fields: [categoryId], references: [id])
  fileUrl     String?
  status      ContentStatus   @default(DRAFT)
  isFeatured  Boolean         @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([categoryId])
  @@index([status])
  @@index([year])
  @@index([isFeatured])
}

model SavedFreeResource {
  id           String       @id @default(cuid())
  studentId    String
  student      User         @relation(fields: [studentId], references: [id])
  resourceId   String
  resource     FreeResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  createdAt    DateTime     @default(now())

  @@unique([studentId, resourceId])
  @@index([studentId])
}

// ============================================================
// SYSTEM
// ============================================================

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
}

model PlatformSetting {
  id        String      @id @default(cuid())
  key       String      @unique
  value     String
  type      SettingType @default(STRING)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model Announcement {
  id        String           @id @default(cuid())
  title     String
  message   String           @db.Text
  type      AnnouncementType @default(INFO)
  startAt   DateTime
  endAt     DateTime?
  isActive  Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([isActive])
  @@index([startAt, endAt])
}