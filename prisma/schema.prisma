generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String                  @id @default(cuid())
  name                 String
  email                String                  @unique
  passwordHash         String
  role                 Role                    @default(STUDENT)
  status               UserStatus              @default(ACTIVE)
  phone                String?
  avatarUrl            String?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  academicYear         AcademicYear?
  auditLogs            AuditLog[]
  coursesOwned         Course[]
  uploadedMedia        CourseMedia[]
  conversationsAsDoc   DoctorConversation[]    @relation("DocConversations")
  conversationsAsStu   DoctorConversation[]    @relation("StuConversations")
  doctorMessagesSent   DoctorMessage[]
  payoutsApproved      DoctorPayout[]          @relation("PayoutApprover")
  payoutsReceived      DoctorPayout[]          @relation("DoctorPayouts")
  doctorProfile        DoctorProfile?
  enrollments          Enrollment[]
  examsCreated         Exam[]
  examAttempts         ExamAttempt[]
  finTxAsDoctor        FinancialTransaction[]  @relation("FinTxDoctor")
  finTxAsStudent       FinancialTransaction[]  @relation("FinTxStudent")
  lessonProgress       LessonProgress[]
  notifications        Notification[]
  notificationPref     NotificationPreference?
  passwordResetTokens  PasswordResetToken[]
  paymentsReviewed     Payment[]               @relation("PaymentReviewer")
  paymentsMade         Payment[]               @relation("StudentPayments")
  savedFreeResources   SavedFreeResource[]
  secretaryInvitesSent SecretaryInvitation[]   @relation("InvitationSender")
  secretaries          SecretaryProfile[]      @relation("DoctorSecretary")
  secretaryProfile     SecretaryProfile?
  supportMessages      SupportMessage[]
  supportAssigned      SupportTicket[]         @relation("TicketAssignee")
  supportTicketsOwned  SupportTicket[]         @relation("TicketOwner")
  verificationTokens   VerificationToken[]

  @@index([role])
  @@index([status])
  @@index([email])
}

model DoctorProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  slug        String   @unique
  specialty   String
  bio         String?
  rating      Decimal  @default(0) @db.Decimal(3, 1)
  isVerified  Boolean  @default(false)
  isAvailable Boolean  @default(true)
  avatarColor String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([slug])
  @@index([isVerified])
}

model SecretaryProfile {
  id          String       @id @default(cuid())
  userId      String       @unique
  doctorId    String
  permissions Permission[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  doctor      User         @relation("DoctorSecretary", fields: [doctorId], references: [id])
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([doctorId])
}

model SecretaryInvitation {
  id          String           @id @default(cuid())
  email       String
  doctorId    String
  token       String           @unique
  permissions Permission[]
  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime
  createdAt   DateTime         @default(now())
  doctor      User             @relation("InvitationSender", fields: [doctorId], references: [id])

  @@index([doctorId])
  @@index([email])
  @@index([token])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model CourseCategory {
  id            String         @id @default(cuid())
  name          String
  slug          String         @unique
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  courses       Course[]
  freeResources FreeResource[]
  previousExams PreviousExam[]
}

model Course {
  id                String                 @id @default(cuid())
  doctorId          String
  title             String
  slug              String                 @unique
  shortDescription  String?
  description       String?
  thumbnail         String?
  thumbnailColor    String?
  categoryId        String?
  price             Decimal                @default(0) @db.Decimal(10, 2)
  status            CourseStatus           @default(DRAFT)
  level             String                 @default("BEGINNER")
  language          String                 @default("ENGLISH")
  estimatedDuration Int?
  rating            Decimal?               @db.Decimal(3, 1)
  publishedAt       DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  targetYear        AcademicYear?
  category          CourseCategory?        @relation(fields: [categoryId], references: [id])
  doctor            User                   @relation(fields: [doctorId], references: [id])
  media             CourseMedia[]
  sections          CourseSection[]
  lessons           CourseLesson[] // العلاقة العكسية للدروس المستقلة
  conversations     DoctorConversation[]
  enrollments       Enrollment[]
  exams             Exam[]
  financialTx       FinancialTransaction[]
  payments          Payment[]

  @@index([doctorId])
  @@index([categoryId])
  @@index([status])
  @@index([slug])
}

model CourseSection {
  id          String         @id @default(cuid())
  courseId    String
  title       String
  description String?
  order       Int            @default(0)
  lessons     CourseLesson[]
  course      Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
}

model CourseLesson {
  id             String           @id @default(cuid())
  sectionId      String? // أصبح اختياري
  courseId       String? // حقل جديد للدروس المستقلة
  title          String
  description    String?
  type           LessonType
  content        String?
  resourceUrl    String?
  duration       Int?
  order          Int              @default(0)
  isPreview      Boolean          @default(false)
  isPublished    Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  mediaId        String?
  section        CourseSection?   @relation(fields: [sectionId], references: [id], onDelete: Cascade) // العلاقة أصبحت اختيارية
  course         Course?          @relation(fields: [courseId], references: [id]) // العلاقة الجديدة
  lessonProgress LessonProgress[]

  @@index([sectionId])
  @@index([courseId])
  @@index([isPublished])
}

model LessonProgress {
  id          String       @id @default(cuid())
  studentId   String
  lessonId    String
  completed   Boolean      @default(false)
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  lesson      CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  student     User         @relation(fields: [studentId], references: [id])

  @@unique([studentId, lessonId])
  @@index([studentId])
  @@index([lessonId])
}

model Enrollment {
  id          String           @id @default(cuid())
  studentId   String
  courseId    String
  status      EnrollmentStatus @default(PENDING)
  enrolledAt  DateTime         @default(now())
  activatedAt DateTime?
  completedAt DateTime?
  progress    Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  course      Course           @relation(fields: [courseId], references: [id])
  student     User             @relation(fields: [studentId], references: [id])
  payments    Payment[]

  @@unique([studentId, courseId])
  @@index([studentId])
  @@index([courseId])
  @@index([status])
}

model Exam {
  id              String        @id @default(cuid())
  doctorId        String
  courseId        String?
  title           String
  description     String?
  type            ExamType
  duration        Int
  passingScore    Int
  attemptsAllowed Int           @default(1)
  status          ExamStatus    @default(DRAFT)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  course          Course?       @relation(fields: [courseId], references: [id])
  doctor          User          @relation(fields: [doctorId], references: [id])
  attempts        ExamAttempt[]
  questions       Question[]

  @@index([doctorId])
  @@index([courseId])
  @@index([status])
}

model Question {
  id          String           @id @default(cuid())
  examId      String
  text        String
  type        QuestionType
  points      Int              @default(1)
  order       Int              @default(0)
  explanation String?
  answers     ExamAnswer[]
  exam        Exam             @relation(fields: [examId], references: [id], onDelete: Cascade)
  choices     QuestionChoice[]

  @@index([examId])
}

model QuestionChoice {
  id         String       @id @default(cuid())
  questionId String
  text       String
  isCorrect  Boolean      @default(false)
  order      Int          @default(0)
  answers    ExamAnswer[]
  question   Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

model ExamAttempt {
  id          String        @id @default(cuid())
  examId      String
  studentId   String
  startedAt   DateTime      @default(now())
  submittedAt DateTime?
  score       Int?
  percentage  Decimal?      @db.Decimal(5, 2)
  passed      Boolean?
  status      AttemptStatus @default(IN_PROGRESS)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  answers     ExamAnswer[]
  exam        Exam          @relation(fields: [examId], references: [id])
  student     User          @relation(fields: [studentId], references: [id])

  @@index([examId])
  @@index([studentId])
  @@index([status])
}

model ExamAnswer {
  id         String          @id @default(cuid())
  attemptId  String
  questionId String
  choiceId   String?
  textAnswer String?
  createdAt  DateTime        @default(now())
  attempt    ExamAttempt     @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  choice     QuestionChoice? @relation(fields: [choiceId], references: [id])
  question   Question        @relation(fields: [questionId], references: [id])

  @@unique([attemptId, questionId])
  @@index([attemptId])
}

model Payment {
  id                    String                 @id @default(cuid())
  studentId             String
  courseId              String
  enrollmentId          String?
  amount                Decimal                @db.Decimal(10, 2)
  currency              String                 @default("EGP")
  method                PaymentMethod
  status                PaymentStatus          @default(PENDING)
  referenceNumber       String?
  proofUrl              String?
  studentNote           String?
  rejectionReason       String?
  adminNote             String?
  reviewedBy            String?
  reviewedAt            DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  paymentConfigSnapshot Json?
  financialTransactions FinancialTransaction[]
  course                Course                 @relation(fields: [courseId], references: [id])
  enrollment            Enrollment?            @relation(fields: [enrollmentId], references: [id])
  reviewer              User?                  @relation("PaymentReviewer", fields: [reviewedBy], references: [id])
  student               User                   @relation("StudentPayments", fields: [studentId], references: [id])

  @@index([studentId])
  @@index([courseId])
  @@index([status])
  @@index([enrollmentId])
}

model PlatformFeeConfig {
  id          String         @id @default(cuid())
  type        CommissionType
  fixedAmount Decimal?       @db.Decimal(10, 2)
  percentage  Decimal?       @db.Decimal(5, 2)
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model FinancialTransaction {
  id                 String            @id @default(cuid())
  paymentId          String?
  payoutId           String?
  courseId           String?
  doctorId           String
  studentId          String?
  grossAmount        Decimal           @db.Decimal(10, 2)
  platformCommission Decimal           @db.Decimal(10, 2)
  doctorNet          Decimal           @db.Decimal(10, 2)
  currency           String            @default("EGP")
  type               FinancialTxType
  status             FinancialTxStatus @default(PENDING)
  createdAt          DateTime          @default(now())
  course             Course?           @relation(fields: [courseId], references: [id])
  doctor             User              @relation("FinTxDoctor", fields: [doctorId], references: [id])
  payment            Payment?          @relation(fields: [paymentId], references: [id])
  payout             DoctorPayout?     @relation("PayoutFinTx", fields: [payoutId], references: [id])
  student            User?             @relation("FinTxStudent", fields: [studentId], references: [id])

  @@index([paymentId])
  @@index([payoutId])
  @@index([doctorId])
  @@index([studentId])
  @@index([courseId])
  @@index([status])
  @@index([type])
}

model DoctorPayout {
  id                    String                 @id @default(cuid())
  doctorId              String
  amount                Decimal                @db.Decimal(10, 2)
  currency              String                 @default("EGP")
  method                String
  status                PayoutStatus           @default(REQUESTED)
  reference             String?
  note                  String?
  approvedBy            String?
  processedAt           DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  approver              User?                  @relation("PayoutApprover", fields: [approvedBy], references: [id])
  doctor                User                   @relation("DoctorPayouts", fields: [doctorId], references: [id])
  financialTransactions FinancialTransaction[] @relation("PayoutFinTx")

  @@index([doctorId])
  @@index([status])
}

model SupportTicket {
  id         String           @id @default(cuid())
  userId     String
  subject    String
  category   String
  priority   SupportPriority  @default(MEDIUM)
  status     SupportStatus    @default(OPEN)
  assignedTo String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  messages   SupportMessage[]
  assignee   User?            @relation("TicketAssignee", fields: [assignedTo], references: [id])
  user       User             @relation("TicketOwner", fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([priority])
  @@index([assignedTo])
}

model SupportMessage {
  id        String        @id @default(cuid())
  ticketId  String
  senderId  String
  body      String
  createdAt DateTime      @default(now())
  sender    User          @relation(fields: [senderId], references: [id])
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([senderId])
}

model DoctorConversation {
  id        String             @id @default(cuid())
  doctorId  String
  studentId String
  courseId  String?
  status    ConversationStatus @default(OPEN)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  course    Course?            @relation(fields: [courseId], references: [id])
  doctor    User               @relation("DocConversations", fields: [doctorId], references: [id])
  student   User               @relation("StuConversations", fields: [studentId], references: [id])
  messages  DoctorMessage[]

  @@unique([doctorId, studentId, courseId])
  @@index([doctorId])
  @@index([studentId])
  @@index([status])
}

model DoctorMessage {
  id             String             @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  isRead         Boolean            @default(false)
  readAt         DateTime?
  createdAt      DateTime           @default(now())
  conversation   DoctorConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User               @relation(fields: [senderId], references: [id])

  @@index([conversationId])
  @@index([senderId])
  @@index([isRead])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  href      String?
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}

model NotificationPreference {
  id             String   @id @default(cuid())
  userId         String   @unique
  emailEnabled   Boolean  @default(true)
  pushEnabled    Boolean  @default(true)
  paymentAlerts  Boolean  @default(true)
  supportReplies Boolean  @default(true)
  doctorMessages Boolean  @default(true)
  systemAlerts   Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FreeResource {
  id          String              @id @default(cuid())
  title       String
  slug        String              @unique
  description String?
  type        FreeResourceType
  categoryId  String?
  thumbnail   String?
  content     String?
  resourceUrl String?
  videoUrl    String?
  status      ContentStatus       @default(DRAFT)
  isFeatured  Boolean             @default(false)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  category    CourseCategory?     @relation(fields: [categoryId], references: [id])
  savedBy     SavedFreeResource[]

  @@index([categoryId])
  @@index([status])
  @@index([type])
  @@index([isFeatured])
}

model PreviousExam {
  id          String          @id @default(cuid())
  title       String
  slug        String          @unique
  description String?
  year        Int
  university  String?
  faculty     String?
  specialty   String?
  categoryId  String?
  fileUrl     String?
  status      ContentStatus   @default(DRAFT)
  isFeatured  Boolean         @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  category    CourseCategory? @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
  @@index([status])
  @@index([year])
  @@index([isFeatured])
}

model SavedFreeResource {
  id         String       @id @default(cuid())
  studentId  String
  resourceId String
  createdAt  DateTime     @default(now())
  resource   FreeResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  student    User         @relation(fields: [studentId], references: [id])

  @@unique([studentId, resourceId])
  @@index([studentId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id])

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
}

model PlatformSetting {
  id        String      @id @default(cuid())
  key       String      @unique
  value     String
  type      SettingType @default(STRING)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model Announcement {
  id        String           @id @default(cuid())
  title     String
  message   String
  type      AnnouncementType @default(INFO)
  startAt   DateTime
  endAt     DateTime?
  isActive  Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([isActive])
  @@index([startAt, endAt])
}

model CourseMedia {
  id            String      @id @default(cuid())
  courseId      String
  kind          MediaKind
  objectKey     String      @unique
  originalName  String
  mimeType      String
  sizeBytes     BigInt
  duration      Int?
  status        MediaStatus @default(PENDING)
  lectureOrder  Int?
  lectureTitle  String?
  uploadedById  String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  streamvaultId String?
  course        Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  uploadedBy    User        @relation(fields: [uploadedById], references: [id])

  @@index([courseId])
  @@index([kind])
  @@index([status])
  @@index([streamvaultId])
}

model VerificationToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model StorageUsage {
  id          String   @id @default(cuid())
  totalBytes  BigInt   @default(0)
  totalVideos Int      @default(0)
  updatedAt   DateTime @updatedAt
}

enum Role {
  SUPER_ADMIN
  DOCTOR
  SECRETARY
  STUDENT
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

enum Permission {
  VIEW_STUDENTS
  MANAGE_STUDENTS
  VIEW_COURSES
  MANAGE_COURSES
  VIEW_EXAMS
  MANAGE_EXAMS
  VIEW_SUBMISSIONS
  MANAGE_SUBMISSIONS
  VIEW_MESSAGES
  MANAGE_MESSAGES
  VIEW_SUPPORT
  MANAGE_SUPPORT
  VIEW_FINANCE
  MANAGE_FINANCE
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum LessonType {
  VIDEO
  PDF
  TEXT
  FILE
}

enum ExamType {
  COURSE_EXAM
  PRACTICE_EXAM
  PREVIOUS_EXAM
}

enum ExamStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  ESSAY
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  GRADED
  EXPIRED
}

enum EnrollmentStatus {
  PENDING
  ACTIVE
  COMPLETED
  SUSPENDED
  CANCELLED
}

enum PaymentMethod {
  CASH
  INSTAPAY
  VODAFONE_CASH
}

enum CommissionType {
  FIXED
  PERCENTAGE
}

enum FinancialTxType {
  COURSE_SALE
  REFUND
  ADJUSTMENT
  PAYOUT
}

enum FinancialTxStatus {
  PENDING
  POSTED
  REVERSED
}

enum PaymentStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  CANCELLED
  AWAITING_PAYMENT
}

enum PayoutStatus {
  REQUESTED
  APPROVED
  PROCESSING
  COMPLETED
  REJECTED
  CANCELLED
}

enum FreeResourceType {
  PDF
  VIDEO
  TEXT
  FILE
  IMAGE
  LINK
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum NotificationType {
  PAYMENT_APPROVED
  SUPPORT_REPLY
  DOCTOR_MESSAGE
  SYSTEM
}

enum SupportStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_USER
  RESOLVED
  CLOSED
}

enum SupportPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ConversationStatus {
  OPEN
  CLOSED
}

enum AnnouncementType {
  INFO
  WARNING
  IMPORTANT
  MAINTENANCE
}

enum SettingType {
  STRING
  NUMBER
  BOOLEAN
  JSON
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

enum AcademicYear {
  YEAR_1
  YEAR_2
  YEAR_3
  YEAR_4
  YEAR_5
}

enum MediaKind {
  PREVIEW
  LECTURE
}

enum MediaStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}